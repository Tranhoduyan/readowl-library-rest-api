{
  "info": {
    "_postman_id": "9f8c7b6a-5432-4123-89ab-cdef01234567",
    "name": "Library Management REST API — Full Merged Collection (Nguoi 1 + Nguoi 2)",
    "description": "Bộ kiểm thử Postman toàn diện tích hợp cả Người 1 (Auth, Users, Loans) và Người 2 (Categories, Books, Public Search, Statistics) cho Hệ thống Thư viện Mượn - Trả Sách.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testBookId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testLoanId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth & Tai khoan (Nguoi 1)",
      "item": [
        {
          "name": "A01 - Login Admin (200 OK & Luu adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.success).to.eql(true);",
                  "pm.expect(json.data.access_token).to.be.a('string');",
                  "pm.collectionVariables.set('adminToken', json.data.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin12345\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "A02 - Login Member (200 OK & Luu memberToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.success).to.eql(true);",
                  "pm.collectionVariables.set('memberToken', json.data.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"an@example.com\",\n  \"password\": \"ThuVien123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "A03 - GET /auth/me (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.email).to.eql('an@example.com');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "02 - Categories - Quan ly Danh muc (Nguoi 2)",
      "item": [
        {
          "name": "DM01 - GET /categories (Public - 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "DM02 - POST /categories (Admin - 201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('testCategoryId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Danh mục Postman Test\",\n  \"description\": \"Tạo tự động từ Postman\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "DM04 - DELETE /categories/1 (Danh muc dang co sach -> 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 409 Conflict', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/categories/1"
          }
        },
        {
          "name": "DM04 - DELETE /categories/{{testCategoryId}} (Danh muc rong -> 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/categories/{{testCategoryId}}"
          }
        }
      ]
    },
    {
      "name": "03 - Books - Tra cuu & Quan ly Sach (Nguoi 2)",
      "item": [
        {
          "name": "B01/B02 - GET /books (Public - Chi tra sach is_active=1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const books = json.data.books;",
                  "pm.expect(books).to.be.an('array');",
                  "books.forEach(b => pm.expect(b.is_active).to.eql(1));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?page=1&limit=10"
          }
        },
        {
          "name": "B03 - GET /books?include_inactive=1 (Member -> 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/books?include_inactive=1"
          }
        },
        {
          "name": "B04 - GET /books?page=0&limit=999&sort=invalid (422 Validation Error)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 422 Unprocessable Entity', function () { pm.response.to.have.status(422); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?page=0&limit=999&sort=invalid"
          }
        },
        {
          "name": "B06 - GET /books/20 (Sach is_active=0 voi Guest -> 404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 404 Not Found', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/20"
          }
        },
        {
          "name": "B07 - GET /books/20 (Sach is_active=0 voi Admin -> 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().data.is_active).to.eql(0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/books/20"
          }
        },
        {
          "name": "B10 - POST /books (Admin tao sach moi -> 201 Created, available=total)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.available_copies).to.eql(json.data.total_copies);",
                  "pm.collectionVariables.set('testBookId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"title\": \"Sách Kiểm Thử Postman\",\n  \"author\": \"Antigravity QA\",\n  \"publisher\": \"NXB Đại Học\",\n  \"publish_year\": 2024,\n  \"total_copies\": 5\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "B12 - PUT /books/1 (Giam total_copies < so ban dang muon -> 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 409 Conflict', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"title\": \"Clean Code — Mã Nguồn Sạch\",\n  \"author\": \"Robert C. Martin\",\n  \"total_copies\": 0\n}"
            },
            "url": "{{baseUrl}}/books/1"
          }
        },
        {
          "name": "B14 - DELETE /books/{{testBookId}} (Xoa sach chua co lich su -> 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/books/{{testBookId}}"
          }
        }
      ]
    },
    {
      "name": "04 - Statistics - Thong ke He thong (Nguoi 2)",
      "item": [
        {
          "name": "B18 - GET /statistics (Guest -> 401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/statistics"
          }
        },
        {
          "name": "B19 - GET /statistics (Member -> 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{memberToken}}" }],
            "url": "{{baseUrl}}/statistics"
          }
        },
        {
          "name": "B20/B21 - GET /statistics (Admin -> 200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.summary).to.be.an('object');",
                  "pm.expect(json.data.top_books).to.be.an('array');",
                  "pm.expect(json.data.overdue_list).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/statistics"
          }
        }
      ]
    }
  ]
}
