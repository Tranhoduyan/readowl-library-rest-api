{
  "info": {
    "name": "Library REST API - Member 1 (Auth, Users, Loans)",
    "_postman_id": "a7f3c912-6041-4c75-9d18-4dd5031e1f85",
    "description": "Các request dùng một độc giả TEST riêng. Chạy theo thứ tự bằng Collection Runner. Kết thúc sẽ khóa tài khoản TEST và giữ lịch sử. Các test này là tuần tự, không chứng minh xử lý đồng thời.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "memberToken",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": ""
    },
    {
      "key": "memberPassword",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth & Profile",
      "item": [
        {
          "name": "POST /auth/register - Đăng ký độc giả mới",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"TEST Postman - có thể khóa\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('memberEmail', 'test.postman.' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
                  "pm.collectionVariables.set('memberPassword', 'Test_' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.unset('memberId');",
                  "pm.collectionVariables.unset('memberToken');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data) { pm.collectionVariables.set('memberId', json.data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login - Đăng nhập Admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('adminToken');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data && json.data.access_token) { pm.collectionVariables.set('adminToken', json.data.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin12345\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login - Đăng nhập Member",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('memberToken');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data && json.data.access_token) { pm.collectionVariables.set('memberToken', json.data.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            }
          }
        },
        {
          "name": "GET /me - Xem hồ sơ cá nhân hiện tại",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users Management (Admin)",
      "item": [
        {
          "name": "GET /users - Danh sách độc giả (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/users?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('data là mảng và có meta', function () { const json = pm.response.json(); pm.expect(json.data).to.be.an('array'); pm.expect(json.meta).to.have.property('total'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/{id} - Chi tiết độc giả TEST",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{memberId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /users/{id} - Khóa / Mở khóa độc giả",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{memberId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Loans Workflow (Member & Admin)",
      "item": [
        {
          "name": "GET /books - Chọn sách đang hoạt động còn bản",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('bookId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const books = pm.response.json().data.books;",
                  "const book = books.find(function (b) { return b.is_active === 1 && b.available_copies > 0; });",
                  "pm.test('Có sách còn bản để thử mượn', function () { pm.expect(book).to.exist; });",
                  "if (book) { pm.collectionVariables.set('bookId', book.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "POST /loans - Độc giả tạo yêu cầu mượn sách",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('loanId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 201 && json.data) { pm.collectionVariables.set('loanId', json.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": "{{baseUrl}}/loans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": {{bookId}}\n}"
            }
          }
        },
        {
          "name": "GET /loans - Xem danh sách phiếu mượn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/loans?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /loans/{id} - Admin duyệt & giao sách (borrowed)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/loans/{{loanId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"borrowed\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /loans/{id} - Admin xác nhận trả sách (returned)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/loans/{{loanId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"returned\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /users/{id} - Chặn xóa độc giả đã có lịch sử",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{memberId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', function () { pm.response.to.have.status(409); });",
                  "pm.test('Giữ lịch sử', function () { pm.expect(pm.response.json().error.code).to.eql('USER_HAS_LOAN_HISTORY'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /users/{id} - Khóa tài khoản TEST sau khi chạy",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users/{{memberId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
